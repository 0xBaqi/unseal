# Unseal Production Environment Variables
# Copy to .env.production on the server and populate with production secrets.
# NEVER commit .env.production to version control.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Cloudflare R2 Credentials (unseal-private)
R2_BUCKET_NAME=unseal-private
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Tunnel Connector Token (unseal.baronal.xyz)
TUNNEL_TOKEN=
